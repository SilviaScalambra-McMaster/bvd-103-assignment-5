{
  "compilerOptions": {
    "lib": [
      "es2023",
      "dom"
    ],
    "module": "CommonJS",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "services/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "build/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
