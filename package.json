{
  "name": "mcmasterful-books-assignment-7",
  "version": "1.0.0",
  "private": true,
  "description": "BDV 103 Assignment 7 - separated services and RabbitMQ messaging",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "generate": "npm run generate:spec && npm run generate:sdk",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "start:catalogue": "npm --workspace @mcmasterful/catalogue run start",
    "start:warehouse": "npm --workspace @mcmasterful/warehouse run start",
    "start:orders": "npm --workspace @mcmasterful/orders run start",
    "start:swagger": "npm --workspace @mcmasterful/swagger run start",
    "generate:sdk": "openapi-generator-cli generate -i ./services/swagger/build/swagger.json -o ./client -g typescript-fetch --additional-properties=useSingleRequestParameter=true",
    "generate:spec": "node scripts/generate-openapi.mjs"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "12.0.1",
    "amqplib": "^0.10.9",
    "is-generator-function": "1.0.4",
    "koa": "^2.16.3",
    "koa-bodyparser": "^4.4.1",
    "koa-qs": "^3.0.0",
    "koa2-swagger-ui": "5.12.0",
    "mongodb": "^7.7.0",
    "tsoa": "^5.1.1",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/amqplib": "^0.10.7",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-qs": "^2.0.3",
    "@types/node": "^22.19.3",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.6.2",
    "@openapitools/openapi-generator-cli": "^2.13.12"
  },
  "overrides": {
    "is-generator-function": "1.0.4"
  }
}
